rules_version = '2';
// Salsamas Cockpit: Zugriff auf die Datenbank NUR ueber den App-Server (Dienstkonto cockpit-run).
// Browser/Handys duerfen nie direkt auf Firestore zugreifen. Aktiv seit 05.11.2026.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
